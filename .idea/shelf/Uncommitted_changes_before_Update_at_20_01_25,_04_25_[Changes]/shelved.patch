+        <iframe
+          *ngIf="safeHelpDocUrl"
+          [src]="safeHelpDocUrl"
+          (error)="handleIframeError()"
+          width="100%"
+          height="600px"
+        ></iframe>
+          <iframe *ngIf="!safeHelpDocUrl"
+            [src]="sanitizer.bypassSecurityTrustResourceUrl(defaultHelpDocUrl)"
