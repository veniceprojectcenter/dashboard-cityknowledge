+      <h1>{{ dashboard?.pageTitle }}</h1>
+      <div class="coords">
+        <span class="coordinates-label">Coordinates:</span>
+        <span class="coordinates-value">N {{ dashboard!.coords[0]  }}, E {{ dashboard!.coords[1]}}</span>
+      </div>
+      <button (click)="openHelpDoc()">
